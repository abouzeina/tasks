{
  "name": "daily-task-hub",
  "version": "1.0.0",
  "description": "Smart Daily Task & Habit Tracker with Focus Timer and Analytics",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
